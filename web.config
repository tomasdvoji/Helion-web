<?xml version="1.0" encoding="utf-8"?>
<!--
  HELION.CZ — konfigurace pro IIS 10 (ASPone, Windows Server 2022)
  ===========================================================================
  SLOUČENO 7. 9. 2026 s web.config, který už v repozitáři byl (commit f38a24e).
  Nic z původního souboru nezmizelo — MIME typy včetně .mp4 zůstávají,
  defaultDocument taky. Přibyly čtyři věci: kanonická varianta, vlastní
  chybové stránky, hlavičky a cache. A pravidlo http→https se zapnulo.

  Modul URL Rewrite je ověřený: původní soubor sekci <rewrite> obsahoval
  a web vracel 200, ne 500.19. Kdyby modul chyběl, IIS by na nerozpoznanou
  konfigurační sekci spadl u každého požadavku.

  ---------------------------------------------------------------------------
  Co se mění proti původnímu souboru a proč

  1) PRAVIDLO http→https SE ZAPÍNÁ. V původním souboru bylo enabled="false"
     s poznámkou "až bude na ASPone vydaný certifikát". Certifikát vydaný je
     — https://www.helion.cz i https://helion.cz odpovídají (ověřeno 7. 9.).
     Zatím ale http odpovídá taky, a to je problém: stránka po http jede
     nešifrovaně a hlavně je to pro prohlížeč JINÝ PŮVOD. Souhlas s cookies
     i zachycený gclid se ukládají do localStorage, který je na původ vázaný,
     takže se dnes drobí na čtyři nezávislé skladiště:
         http://helion.cz    http://www.helion.cz
         https://helion.cz   https://www.helion.cz
     Člověk, který přijde z reklamy na jedno a odešle poptávku z druhého,
     přijde o gclid. Přesně ta chyba, kvůli které loni skončilo 14 ze 17
     poptávek jako "Direct".

  2) APEX NA WWW. Dnes helion.cz i www.helion.cz vracejí 200 se stejným
     obsahem a nic mezi nimi nepřesměrovává. Google indexuje dvě adresy
     s týmž obsahem a měření se tříští stejně jako v bodě 1. Kanonická
     je www — na tu ukazuje sitemap.xml i strukturovaná data.

  3) VLASTNÍ 404. Dnes se vrací výchozí stránka IIS v iso-8859-1
     ("404 - File or directory not found"), takže překlep v reklamní URL
     končí u stránky hostera.

  4) HLAVIČKY A CACHE. Referrer-Policy je tu měřicí, ne bezpečnostní
     záležitost: referrer musí dorazit k nám, jinak poptávka spadne
     do "Direct".

  ---------------------------------------------------------------------------
  POZOR PŘI NASAZENÍ

  Pořadí pravidel je záměrné. "apex na www" jde první a přesměrovává rovnou
  na https, aby návštěvník z http://helion.cz nedostal dva skoky za sebou.

  Kdyby se po nahrání objevila chyba 500.19, vraťte předchozí web.config
  (je v gitu) a napište podpoře ASPone — support@aspone.cz, 576 510 055.
-->
<configuration>
  <system.webServer>

    <!-- ================= PŘEVZATO Z PŮVODNÍHO SOUBORU ================= -->

    <staticContent>
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mp4" /><mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" /><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <defaultDocument><files><clear /><add value="index.html" /></files></defaultDocument>

    <!-- ================= PŘESMĚROVÁNÍ ================= -->

    <rewrite>
      <rules>
        <!-- 1) apex → www, rovnou na https (jeden skok, ne dva) -->
        <rule name="apex na www" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^helion\.cz$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.helion.cz/{R:1}"
                  redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- 2) http → https (původní pravidlo, nově zapnuté) -->
        <rule name="http na https" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.helion.cz/{R:1}"
                  redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- ================= CHYBOVÉ STRÁNKY ================= -->

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
      <error statusCode="500" path="/500.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- ================= HLAVIČKY ================= -->

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <!-- web je statický, ASP.NET tu nic neobsluhuje -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>

  <!-- ================= CACHE ================= -->
  <!-- HTML se necachuje vůbec — jinak by se nová vstupní stránka neprojevila. -->

  <location path="css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="media">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Měřicí skripty krátce — mění se s nastavením kampaní. -->
  <location path="consent.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="attribution.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="mereni.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="konfigurator-mereni.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
